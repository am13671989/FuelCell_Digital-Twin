# Copy to server/.env and edit. Never commit .env.
# Space-separated Modelica class paths to export as FMUs (folder path inside modelica/ = package path)
MODELS=FCDT.Systems.FullSystemCool
API_KEY=change-me-to-a-long-random-string
# Host port and address for the dashboard. Use DASH_BIND=127.0.0.1 behind an existing reverse proxy.
DASH_PORT=8050
DASH_BIND=0.0.0.0
